{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C: Debug ThreadPool",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/ThreadPool/threadpool_test",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
